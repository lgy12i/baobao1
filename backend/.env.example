# ============ 服务端口 ============
PORT=3000

# ============ 数据库 ============
MONGODB_URI=mongodb://localhost:27017/taotao_mall
REDIS_URL=redis://localhost:6379

# ============ JWT ============
JWT_SECRET=please-change-this-to-random-strong-secret
JWT_EXPIRES_IN=7d

# ============ 支付 ============
STRIPE_SECRET_KEY=sk_test_xxx

# ============ 上传 ============
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ============ 环境 ============
NODE_ENV=development

# ============ AI 助手（OpenAI 兼容协议）============
# 主模型配置（默认阿里云 DashScope 通义千问 qwen-max）
# 注意：API Key 不要入库，写在 .env 中（.env 已在 .gitignore）
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-max

# 备用模型（主模型不可用时降级到 DeepSeek，可不配）
AI_FALLBACK_KEY=
AI_FALLBACK_BASE=https://api.deepseek.com/v1
AI_FALLBACK_MODEL=deepseek-chat

# 豆包（火山引擎）配置示例：
# AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_MODEL=doubao-pro-32k
