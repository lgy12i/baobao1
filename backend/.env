 服务端口
PORT=3000

# MongoDB 连接地址
MONGODB_URI=mongodb://localhost:27017/taotao_mall

# Redis 连接地址
REDIS_URL=redis://localhost:6379

# JWT 密钥（生产环境应使用随机生成的强密钥）
JWT_SECRET=baobao-mall-jwt-secret-key-2026
JWT_EXPIRES_IN=7d

# 支付密钥（模拟 Stripe）
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# 上传文件配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# 环境变量
NODE_ENV=development
