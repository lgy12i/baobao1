# =============================================================
# docker-compose 配套环境变量示例
# 复制为 .env 后修改里面关键密码即可使用
# 面试讲解：
#   - 12-Factor 原则：配置与代码解耦，通过环境变量注入
#   - 敏感信息（密码、密钥）不进代码仓库，通过 .env / CI Secrets 注入
# =============================================================

# -------- MongoDB --------
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=taotao_root_pwd_2026
MONGO_DB=taotao_mall
APP_USER=taotao
APP_PASS=taotao_db_pwd_2026

# -------- Redis --------
REDIS_PASSWORD=taotao_redis_pwd_2026

# -------- 后端 --------
JWT_SECRET=taotao-mall-jwt-secret-change-me-in-production!
JWT_EXPIRES_IN=7d
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# -------- 镜像仓库（CI/CD 推送用） --------
# 如果用 Docker Hub：DOCKER_REGISTRY=docker.io/yourname
# 如果用阿里云 ACR：DOCKER_REGISTRY=registry.cn-hangzhou.aliyuncs.com/yournamespace
DOCKER_REGISTRY=docker.io/lgy12i
IMAGE_NAME=baobao-mall
