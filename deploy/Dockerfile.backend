# =============================================================
# 后端服务 Dockerfile (Node.js + Express)
# 构建策略：多阶段构建
#  Stage 1：安装全部依赖 + 复制源码（构建依赖）
#  Stage 2：仅安装生产依赖 + 复制构建产物，镜像体积最小化
# =============================================================

# ---------- 阶段 1：基础镜像 + 依赖安装 ----------
FROM node:20-alpine AS deps
WORKDIR /app

# 仅先复制 package*.json，利用 Docker 缓存层
# 注意：构建上下文为项目根 D:\taotao-mall，所以路径是 backend/package*.json
COPY backend/package*.json ./

# 关键细节：
# 1) npm ci 比 npm install 更快、更可复现（严格依据 package-lock.json）
# 2) 加 --omit=optional 跳过可选依赖，减少体积
RUN npm ci --omit=optional

# ---------- 阶段 2：运行镜像（仅保留生产依赖 + 源码） ----------
FROM node:20-alpine AS runner
WORKDIR /app

# 生产环境：创建非 root 用户运行容器，避免容器逃逸后获得宿主机 root
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# 从构建阶段复制 node_modules
COPY --from=deps /app/node_modules ./node_modules

# 复制后端业务代码（backend 目录来自项目根）
COPY backend ./

# 修正目录所有权
RUN chown -R appuser:appgroup /app

USER appuser

# Node.js 环境变量
ENV NODE_ENV=production
ENV PORT=3000

# 暴露服务端口
EXPOSE 3000

# 健康检查：每 30s 调用 /health 接口，判断容器是否可用
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1

# 启动命令：使用 node 而不是 npm，避免 PID 1 信号处理问题（SIGTERM 无法透传）
CMD ["node", "src/app.js"]
