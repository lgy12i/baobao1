# =============================================================
# 前端服务 Dockerfile (React + Vite + Nginx)
# 构建策略：多阶段构建
#  Stage 1：Node 镜像里执行 vite build，得到静态产物
#  Stage 2：Nginx Alpine 镜像里只放 dist + 自定义 nginx.conf
#           最终镜像仅 20-30MB，极大减小分发成本
# =============================================================

# ---------- 阶段 1：构建静态资源 ----------
FROM node:20-alpine AS build
WORKDIR /app

# 利用缓存：先装依赖，再复制源码
COPY frontend/package*.json ./
RUN npm ci

# 复制整个前端目录
COPY frontend ./

# 执行 vite build，产物在 /app/dist
RUN npm run build

# ---------- 阶段 2：Nginx 运行静态资源 ----------
FROM nginx:1.27-alpine AS runner

# 时区设置（Nginx 日志按东八区记录）
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 1. 把 Vite 构建产物复制到 Nginx 默认静态目录
COPY --from=build /app/dist /usr/share/nginx/html

# 2. 写入自定义 Nginx 配置（支持 SPA 路由、Gzip、缓存策略、反向代理后端 API）
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# 去掉 Nginx 默认站点重复 server
RUN rm -f /etc/nginx/conf.d/default.conf.bak 2>/dev/null || true

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
